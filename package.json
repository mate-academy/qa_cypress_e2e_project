    }
  },
  "lint-staged": {
    "*.js": "eslint --max-warnings=0"
  },
  "dependencies": {
    "@johmun/vue-tags-input": "^2.1.0",
    "axios": "^1.11.0",
    "css-loader": "^5.2.7",
    "marked": "^16.1.1",
    "pg": "^8.20.0",
    "pg-hstore": "^2.3.4",
    "pug-plain-loader": "^1.1.0",
    "sequelize": "^6.37.7",
    "style-loader": "^1.3.0",
    "sweetalert": "^2.1.2",
    "vue": "^2.7.16",
    "vue-axios": "^3.5.2",
    "vue-router": "^3.6.5",
    "vuex": "^3.6.2"
  }
