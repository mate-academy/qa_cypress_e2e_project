{
  "name": "realworld-deno-drash-vue-webpack",
  "version": "0.0.1",
  "description": "RealWorld example app with Deno (Drash), Vue.js, and Webpack",
  "main": "app.ts",
  "scripts": {
    "prepare": "npx husky install",
    "lint": "eslint .",
    "test": "cypress run --browser chrome",
    "webpack": "node_modules/.bin/webpack --mode production --hide-modules --no-watch"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@babel/preset-env": "^7.28.0",
    "@faker-js/faker": "^8.4.1",
    "@simonsmith/cypress-image-snapshot": "^9.1.0",
    "@types/cypress": "^1.1.6",
    "@types/jest": "^30.0.0",
    "@types/mocha": "^10.0.10",
    "@typescript-eslint/eslint-plugin": "^5.52.0",
    "@typescript-eslint/parser": "^5.52.0",
    "babel-loader": "^8.2.5",
    "cypress": "^12.13.0",
    "eslint": "^8.34.0",
    "eslint-config-standard-with-typescript": "^34.0.0",
    "eslint-plugin-cypress": "^2.12.1",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-n": "^15.6.1",
    "eslint-plugin-promise": "^6.1.1",
    "eslint-plugin-vue": "^9.9.0",
    "husky": "^8.0.3",
    "lint-staged": "^13.2.3",
    "sass": "^1.89.2",
    "sass-loader": "^10.5.2",
    "typescript": "^4.9.5",
    "vue-loader": "^15.11.1",
    "vue-template-compiler": "^2.7.16",
    "webpack": "^4.47.0",
    "webpack-cli": "^3.3.12"
  },
  "husky": {
    "hooks": {
